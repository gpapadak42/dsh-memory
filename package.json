{
  "name": "dsh-memory",
  "version": "0.1.0",
  "description": "Persistent cross-session memory for the DeepSeek Harness: durable notes stored outside the session log, injected into every session's system prompt, with memory_save / memory_recall / memory_update / memory_forget tools.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "bundle",
    "memory"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gpapadak42/dsh-memory.git"
  },
  "homepage": "https://github.com/gpapadak42/dsh-memory#readme",
  "bugs": {
    "url": "https://github.com/gpapadak42/dsh-memory/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-home-paths": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@deepseek-ai/schemastery": "3.18.1"
  }
}
